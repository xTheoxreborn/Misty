<UserControl x:Class="Misty.Views.PackEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Misty.Controls"
             xmlns:loc="clr-namespace:Misty.Services"
             Focusable="True" FocusVisualStyle="{x:Null}"
             PreviewKeyDown="Vue_PreviewKeyDown">

    <UserControl.Resources>
        <!-- Catégorie : libellé à gauche, nombre (Tag) à droite -->
        <Style x:Key="CatPill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource NavyBrush}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="10" Background="Transparent" Padding="10,7">
                            <DockPanel>
                                <Border x:Name="Nb" DockPanel.Dock="Right" CornerRadius="7" Background="#40FFFFFF" Padding="6,1"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtNb" Text="{TemplateBinding Tag}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                                </Border>
                                <ContentPresenter VerticalAlignment="Center" TextBlock.Foreground="{TemplateBinding Foreground}">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavyBrush}" />
                                <Setter TargetName="Nb" Property="Background" Value="#33FFFFFF" />
                                <Setter TargetName="TxtNb" Property="Foreground" Value="White" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Outil de dessin : pastille compacte avec icône -->
        <Style x:Key="ToolPill" TargetType="RadioButton" BasedOn="{StaticResource TabPill}">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Curseur coloré (R, G, B) : la couleur vient de Foreground -->
        <Style x:Key="ColorSlider" TargetType="Slider">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="255" />
            <Setter Property="SmallChange" Value="1" />
            <Setter Property="LargeChange" Value="16" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22">
                            <Border Height="6" CornerRadius="3" Background="#8CFFFFFF" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderFill}" Background="{TemplateBinding Foreground}" Command="Slider.DecreaseLarge" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource SliderFill}" Background="Transparent" Command="Slider.IncreaseLarge" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="16" Height="16" CornerRadius="8" Background="White"
                                                        BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Slider}}"
                                                        BorderThickness="3" Effect="{StaticResource SmallShadow}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PetitLabel" TargetType="TextBlock" BasedOn="{StaticResource PixelLabel}">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Margin" Value="2,0,0,6" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="26,0,30,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═══ En-tête ═══ -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="{loc:Tr Editeur_Retour}"
                    VerticalAlignment="Center" Click="BtnRetour_Click" />

            <Border Grid.Column="1" Width="58" Height="58" CornerRadius="16" Background="#1C2335" BorderBrush="White"
                    BorderThickness="2.5" Margin="14,0,14,0" ClipToBounds="True" Cursor="Hand"
                    ToolTip="{loc:Tr Editeur_ChangerIcone}" MouseLeftButtonUp="Icone_Click" Effect="{StaticResource SmallShadow}">
                <Grid>
                    <Image Source="{x:Static controls:PixelArt.BlocHerbe}" Margin="12" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <Image x:Name="ImgIcone" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Grid>
            </Border>

            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock x:Name="TxtPack" Style="{StaticResource PixelLabel}" FontSize="24" Foreground="White"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="0" ShadowDepth="3" Direction="270" Color="#3E526A" />
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="TxtInfo" Style="{StaticResource BodyText}" FontWeight="SemiBold"
                           Foreground="{StaticResource Navy2Brush}" Margin="2,4,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="TxtRecherche" Style="{StaticResource SearchBox}" Width="240" Tag="{loc:Tr Editeur_Rechercher}"
                         TextChanged="TxtRecherche_TextChanged" Margin="0,0,10,0" />
                <Button Style="{StaticResource IconButton}" Content="&#xE8B7;" Width="44" Height="44" Margin="0,0,8,0"
                        ToolTip="{loc:Tr Pack_Dossier}" Click="BtnDossier_Click" />
                <Button x:Name="BtnExporter" Style="{StaticResource PrimaryButton}" Height="44" Click="BtnExporter_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE896;" FontSize="12" Margin="0,0,8,0" Foreground="White" />
                        <TextBlock Text="{loc:Tr Pack_Exporter}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <!-- ═══ Modes + catégories ═══ -->
            <Border Style="{StaticResource GlassCard}" Padding="10">
                <DockPanel>
                    <UniformGrid DockPanel.Dock="Top" Rows="2" Margin="0,0,0,10">
                        <RadioButton x:Name="ModeTout" Style="{StaticResource TabPill}" Content="{loc:Tr Editeur_Tout}"
                                     Tag="tout" GroupName="mode" IsChecked="True" Checked="Mode_Checked" Margin="0,0,0,6" />
                        <RadioButton x:Name="ModePerso" Style="{StaticResource TabPill}"
                                     Tag="perso" GroupName="mode" Checked="Mode_Checked" Margin="0" />
                    </UniformGrid>
                    <Rectangle DockPanel.Dock="Top" Height="1.5" Fill="#66FFFFFF" Margin="4,0,4,10" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="PanneauCategories" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ═══ Grille de textures ═══ -->
            <Border Grid.Column="2" Style="{StaticResource GlassCard}" Padding="14,12,6,12">
                <Grid>
                    <ScrollViewer x:Name="DefilementTextures" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                        <ItemsControl x:Name="ListeTextures">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="62" Height="62" Margin="0,0,8,8" CornerRadius="12"
                                            Cursor="Hand" ToolTip="{Binding Chemin}" MouseLeftButtonDown="Tuile_Click">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#40FFFFFF" />
                                                <Setter Property="BorderBrush" Value="#59FFFFFF" />
                                                <Setter Property="BorderThickness" Value="2" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#A6FFFFFF" />
                                                        <Setter Property="BorderBrush" Value="White" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding Selectionnee}" Value="True">
                                                        <Setter Property="Background" Value="#D9FFFFFF" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource BlueBrush}" />
                                                        <Setter Property="BorderThickness" Value="3" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Image Source="{Binding Miniature}" Margin="9"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                            <Ellipse Width="10" Height="10" Fill="{StaticResource GreenBrush}" Stroke="White" StrokeThickness="1.5"
                                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Modifiee}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Chargement du template / liste vide -->
                    <StackPanel x:Name="PanneauMessage" VerticalAlignment="Center" HorizontalAlignment="Center"
                                MaxWidth="360" Visibility="Collapsed">
                        <Image Source="{x:Static controls:PixelArt.BlocHerbe}" Width="56" Height="56" Opacity="0.85"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        <TextBlock x:Name="TxtMessage" Style="{StaticResource BodyText}" TextWrapping="Wrap"
                                   TextAlignment="Center" Margin="0,14,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ═══ Éditeur intégré ═══ -->
            <Border Grid.Column="4" Style="{StaticResource GlassCard}" Padding="16">
                <Grid>
                    <!-- Aucune texture choisie -->
                    <StackPanel x:Name="TxtVide" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="260">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE70F;" FontSize="34" Foreground="{StaticResource SlateBrush}" />
                        <TextBlock Style="{StaticResource BodyText}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0"
                                   Text="{loc:Tr Editeur_Vide}" />
                    </StackPanel>

                    <ScrollViewer x:Name="PanneauEditeur" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="0,0,4,0">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <TextBlock x:Name="TxtTaille" DockPanel.Dock="Right" Style="{StaticResource PixelLabel}" FontSize="10"
                                           Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock x:Name="TxtTexture" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource NavyBrush}"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                            </DockPanel>

                            <!-- zone de dessin -->
                            <Border Height="250" CornerRadius="14" ClipToBounds="True" Background="#33000000"
                                    BorderBrush="#59FFFFFF" BorderThickness="1.5">
                                <ScrollViewer x:Name="DefilementPlateau" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                              PreviewMouseWheel="Plateau_MouseWheel">
                                    <Grid x:Name="Plateau" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Rectangle x:Name="Damier" />
                                        <Image x:Name="ImgPixels" Stretch="Fill"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                        <Rectangle x:Name="Grille" IsHitTestVisible="False" />
                                        <Rectangle x:Name="Zone" Fill="Transparent" Cursor="Cross"
                                                   MouseLeftButtonDown="Zone_Down" MouseMove="Zone_Move"
                                                   MouseLeftButtonUp="Zone_Up" MouseRightButtonDown="Zone_Droit"
                                                   LostMouseCapture="Zone_LostCapture" />
                                    </Grid>
                                </ScrollViewer>
                            </Border>

                            <!-- zoom + grille -->
                            <DockPanel Margin="0,8,0,0">
                                <CheckBox x:Name="ChkGrille" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                          Content="{loc:Tr Editeur_Grille}" IsChecked="True" VerticalAlignment="Center"
                                          Margin="12,0,0,0" Click="ChkGrille_Click" />
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE71E;" FontSize="13"
                                           Foreground="{StaticResource SlateBrush}" Margin="0,0,8,0" ToolTip="{loc:Tr Editeur_Zoom}" />
                                <Slider x:Name="SldZoom" Style="{StaticResource GlassSlider}" Minimum="1" Maximum="40" Value="10"
                                        TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                        ValueChanged="Zoom_Changed" ToolTip="{loc:Tr Editeur_Zoom}" />
                            </DockPanel>

                            <!-- outils -->
                            <WrapPanel Margin="0,10,0,0">
                                <RadioButton x:Name="OutilCrayon" Style="{StaticResource ToolPill}" Tag="Crayon" GroupName="outil"
                                             IsChecked="True" Checked="Outil_Checked" Content="{loc:Tr Editeur_Crayon}" ToolTip="{loc:Tr Editeur_Crayon_Info}" />
                                <RadioButton x:Name="OutilGomme" Style="{StaticResource ToolPill}" Tag="Gomme" GroupName="outil"
                                             Checked="Outil_Checked" Content="{loc:Tr Editeur_Gomme}" ToolTip="{loc:Tr Editeur_Gomme_Info}" />
                                <RadioButton x:Name="OutilPot" Style="{StaticResource ToolPill}" Tag="Pot" GroupName="outil"
                                             Checked="Outil_Checked" Content="{loc:Tr Editeur_Pot}" ToolTip="{loc:Tr Editeur_Pot_Info}" />
                                <RadioButton x:Name="OutilPipette" Style="{StaticResource ToolPill}" Tag="Pipette" GroupName="outil"
                                             Checked="Outil_Checked" Content="{loc:Tr Editeur_Pipette}" ToolTip="{loc:Tr Editeur_Pipette_Info}" />
                            </WrapPanel>

                            <!-- couleur -->
                            <TextBlock Style="{StaticResource PetitLabel}" Text="{loc:Tr Editeur_Couleur}" Margin="2,8,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,12,0">
                                    <Border x:Name="Echantillon" Width="56" Height="56" CornerRadius="14"
                                            BorderBrush="White" BorderThickness="2.5" Effect="{StaticResource SmallShadow}" />
                                    <TextBox x:Name="TxtHex" Style="{StaticResource GlassTextBox}" Width="56" MaxLength="7" Margin="0,8,0,0"
                                             Padding="2,0" FontSize="11" HorizontalContentAlignment="Center" TextChanged="Hex_Changed" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock DockPanel.Dock="Left" Text="R" Width="14" FontWeight="Bold" Foreground="#E0465A" VerticalAlignment="Center" />
                                        <Slider x:Name="SldR" Style="{StaticResource ColorSlider}" Foreground="#E0465A" ValueChanged="Couleur_Changed" />
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,2">
                                        <TextBlock DockPanel.Dock="Left" Text="G" Width="14" FontWeight="Bold" Foreground="#13B24C" VerticalAlignment="Center" />
                                        <Slider x:Name="SldG" Style="{StaticResource ColorSlider}" Foreground="#13B24C" ValueChanged="Couleur_Changed" />
                                    </DockPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Text="B" Width="14" FontWeight="Bold" Foreground="#2F8CFF" VerticalAlignment="Center" />
                                        <Slider x:Name="SldB" Style="{StaticResource ColorSlider}" Foreground="#2F8CFF" ValueChanged="Couleur_Changed" />
                                    </DockPanel>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="TxtRecentes" Style="{StaticResource PetitLabel}" Text="{loc:Tr Editeur_Recentes}"
                                       Margin="2,12,0,6" Visibility="Collapsed" />
                            <WrapPanel x:Name="Recentes" />

                            <TextBlock Style="{StaticResource PetitLabel}" Text="{loc:Tr Editeur_Couleurs}" Margin="2,10,0,6" />
                            <WrapPanel x:Name="Palette" />

                            <!-- actions -->
                            <Rectangle Height="1.5" Fill="#66FFFFFF" Margin="0,8,0,12" />
                            <DockPanel>
                                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE7A7;" Margin="0,0,6,0"
                                        ToolTip="{loc:Tr Editeur_Annuler_Info}" Click="BtnAnnuler_Click" />
                                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="&#xE7A6;" Margin="0,0,6,0"
                                        ToolTip="{loc:Tr Editeur_Retablir_Info}" Click="BtnRetablir_Click" />
                                <Button Style="{StaticResource PrimaryButton}" Click="BtnEnregistrer_Click" ToolTip="Ctrl+S">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74E;" FontSize="12" Margin="0,0,8,0" Foreground="White" />
                                        <TextBlock x:Name="TxtEnregistrer" Text="{loc:Tr Editeur_Enregistrer}" />
                                    </StackPanel>
                                </Button>
                            </DockPanel>
                            <UniformGrid Columns="2" Margin="0,8,0,0">
                                <Button Style="{StaticResource GlassButton}" Margin="0,0,4,0" Click="BtnPaint_Click"
                                        Content="{loc:Tr Editeur_Externe}" ToolTip="{loc:Tr Editeur_Externe_Info}" />
                                <Button x:Name="BtnReinitialiser" Style="{StaticResource DangerButton}" Margin="4,0,0,0"
                                        Click="BtnReinitialiser_Click" Content="{loc:Tr Editeur_Reinitialiser}" />
                            </UniformGrid>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
