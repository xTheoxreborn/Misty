<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Misty</RootNamespace>
    <AssemblyName>Misty</AssemblyName>
    <ApplicationIcon>Assets\icone.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CmlLib.Core" Version="4.0.6" />
    <PackageReference Include="CmlLib.Core.Auth.Microsoft" Version="3.3.1" />
    <PackageReference Include="CmlLib.Core.Installer.Forge" Version="1.1.1" />
    <PackageReference Include="CmlLib.Core.Installer.NeoForge" Version="4.0.1" />
    <PackageReference Include="DiscordRichPresence" Version="1.6.1.70" />
    <PackageReference Include="Modrinth.Net" Version="3.8.0" />
    <PackageReference Include="Optifine.Installer" Version="1.0.1" />
  </ItemGroup>

  <!-- WPF n'ajoute pas ces usings implicites (conflit de nom avec System.Windows.Shapes.Path) -->
  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\icone.ico" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <!-- Notes de version affichées dans l'app -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="Misty.CHANGELOG.md" Link="CHANGELOG.md" />
  </ItemGroup>

</Project>
