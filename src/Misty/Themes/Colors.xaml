<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══ Palette (relevée sur le visuel de référence) ═══ -->
    <Color x:Key="SkyLightColor">#C4DFF8</Color>
    <Color x:Key="SkyColor">#A8C8EC</Color>
    <Color x:Key="SkyMidColor">#8CB7E3</Color>
    <Color x:Key="SteelColor">#6B90BD</Color>
    <Color x:Key="DeepColor">#4F74A6</Color>
    <Color x:Key="SlateColor">#58738E</Color>
    <Color x:Key="SlateDarkColor">#3E526A</Color>
    <Color x:Key="NavyColor">#1C2335</Color>
    <Color x:Key="Navy2Color">#2A3347</Color>
    <Color x:Key="GreenColor">#1DE062</Color>
    <Color x:Key="GreenDarkColor">#13B24C</Color>
    <Color x:Key="GreenEdgeColor">#0E7F37</Color>
    <Color x:Key="BlueColor">#2F8CFF</Color>
    <Color x:Key="DangerColor">#FF5A6E</Color>

    <SolidColorBrush x:Key="SkyLightBrush" Color="{StaticResource SkyLightColor}" />
    <SolidColorBrush x:Key="SkyBrush" Color="{StaticResource SkyColor}" />
    <SolidColorBrush x:Key="SteelBrush" Color="{StaticResource SteelColor}" />
    <SolidColorBrush x:Key="DeepBrush" Color="{StaticResource DeepColor}" />
    <SolidColorBrush x:Key="SlateBrush" Color="{StaticResource SlateColor}" />
    <SolidColorBrush x:Key="SlateDarkBrush" Color="{StaticResource SlateDarkColor}" />
    <SolidColorBrush x:Key="NavyBrush" Color="{StaticResource NavyColor}" />
    <SolidColorBrush x:Key="Navy2Brush" Color="{StaticResource Navy2Color}" />
    <SolidColorBrush x:Key="GreenBrush" Color="{StaticResource GreenColor}" />
    <SolidColorBrush x:Key="GreenDarkBrushEdge" Color="{StaticResource GreenEdgeColor}" />
    <SolidColorBrush x:Key="BlueBrush" Color="{StaticResource BlueColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />

    <!-- Texte -->
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource NavyColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5A6B82" />
    <SolidColorBrush x:Key="TextOnDarkBrush" Color="#FFFFFF" />

    <!-- Verre dépoli -->
    <SolidColorBrush x:Key="GlassBrush" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="GlassStrongBrush" Color="#A6FFFFFF" />
    <SolidColorBrush x:Key="GlassHoverBrush" Color="#8CFFFFFF" />
    <SolidColorBrush x:Key="GlassBorderBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="GlassDarkBrush" Color="#26203050" />

    <!-- Fond de la fenêtre : dégradé ciel -->
    <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#BAD6F7" />
        <GradientStop Offset="0.45" Color="#95B9E4" />
        <GradientStop Offset="1" Color="#5B7FB0" />
    </LinearGradientBrush>

    <!-- Carte sombre (comme la vignette de l'image) -->
    <LinearGradientBrush x:Key="CardDarkBrush" StartPoint="0,0" EndPoint="0.4,1">
        <GradientStop Offset="0" Color="#8FA6C4" />
        <GradientStop Offset="0.35" Color="#3A4760" />
        <GradientStop Offset="1" Color="#161C2B" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PlayBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#3BEB7B" />
        <GradientStop Offset="1" Color="#16C052" />
    </LinearGradientBrush>

    <!-- Polices -->
    <FontFamily x:Key="PixelFont">pack://application:,,,/Misty;component/Assets/Fonts/#Silkscreen</FontFamily>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

</ResourceDictionary>
